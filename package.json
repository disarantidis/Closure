{
  "name": "closure",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "ui:build": "node scripts/build-ui.js",
    "ui:typecheck": "tsc --noEmit",
    "dtcg:preview": "node scripts/dtcg-preview.js",
    "dtcg:selftest": "node scripts/dtcg-selftest.js",
    "build:web": "style-dictionary build --config sd.web.js",
    "build:android": "style-dictionary build --config sd.android.js",
    "build:ios": "style-dictionary build --config sd.ios.js",
    "build:all": "npm run build:web && npm run build:android && npm run build:ios"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-dictionary": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
